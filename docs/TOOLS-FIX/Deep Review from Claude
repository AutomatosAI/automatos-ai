Sync Service
# orchestrator/modules/tools/sync/composio_action_sync.py

class ComposioActionSyncService:
    """
    Syncs Composio actions and classifies them via LLM.
    Runs on: app enable, daily refresh, manual trigger.
    """
    
    async def sync_app(self, app_id: str, force: bool = False) -> SyncResult:
        """Sync all actions for a Composio app."""
        
        # 1. Fetch actions from Composio
        actions = await self.composio_client.get_app_actions(app_id)
        
        # 2. Check what needs classification
        to_classify = []
        for action in actions:
            existing = await self.db.get_action_metadata(action.id)
            action_hash = self._hash_action(action)
            
            if existing and existing.manually_overridden:
                continue  # Never overwrite manual overrides
            
            if not existing or existing.composio_hash != action_hash or force:
                to_classify.append(action)
        
        # 3. Batch classify (reduces API calls)
        if to_classify:
            classifications = await self._batch_classify(to_classify)
            await self._save_classifications(classifications)
        
        return SyncResult(
            app_id=app_id,
            total_actions=len(actions),
            classified=len(to_classify),
            skipped=len(actions) - len(to_classify)
        )
    
    async def _batch_classify(
        self, 
        actions: list[ComposioAction], 
        batch_size: int = 10
    ) -> list[ActionClassification]:
        """Classify actions in batches to reduce LLM calls."""
        
        results = []
        for batch in chunked(actions, batch_size):
            # Single LLM call for batch of 10 actions
            prompt = self._build_batch_prompt(batch)
            response = await self.llm.complete(prompt, model="gpt-4o-mini")
            results.extend(self._parse_batch_response(response, batch))
        
        return results

