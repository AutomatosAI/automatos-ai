class ToolCapabilityMapper:
    # ... existing code ...
    
    async def get_actions_for_intent(
        self,
        intent: str,
        enabled_apps: list[str],
        include_destructive: bool = False,
        max_actions: int = 15
    ) -> list[ActionRecommendation]:
        """
        Get relevant Composio actions for a user intent.
        Uses locally-stored capability metadata (no API calls).
        """
        
        # 1. Extract capabilities from intent
        required_caps = self._intent_to_capabilities(intent)
        
        # 2. Query local metadata
        query = (
            select(ComposioActionMetadata)
            .where(ComposioActionMetadata.app_id.in_(enabled_apps))
            .where(ComposioActionMetadata.capabilities.overlap(required_caps))
        )
        
        if not include_destructive:
            query = query.where(ComposioActionMetadata.destructive == False)
        
        actions = await self.db.execute(query)
        
        # 3. Rank by relevance (keyword overlap, capability match strength)
        ranked = self._rank_actions(actions, intent, required_caps)
        
        return ranked[:max_actions]
    
    def _intent_to_capabilities(self, intent: str) -> list[str]:
        """Map user intent to capability tags."""
        
        intent_lower = intent.lower()
        caps = []
        
        # Keyword matching (fast, deterministic)
        if any(w in intent_lower for w in ["send", "post", "notify", "tell"]):
            caps.append("message.send")
        if any(w in intent_lower for w in ["read", "get", "fetch", "list", "show"]):
            caps.append("message.read")
            caps.append("data.query")
        if any(w in intent_lower for w in ["create", "add", "new"]):
            caps.append("data.create")
            caps.append("file.write")
        if any(w in intent_lower for w in ["delete", "remove"]):
            caps.append("data.delete")
            caps.append("file.delete")
        # ... etc
        
        return caps

