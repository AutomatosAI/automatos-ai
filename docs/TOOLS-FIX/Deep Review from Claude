What I Would Do Differently
Architecture Change 1: Intent Classification Layer
Before selecting actions, classify the user's intent:

class IntentClassifier:
    """Classify user intent before action selection."""
    
    INTENT_PATTERNS = {
        "message.send": ["send", "post", "message", "tell", "notify", "dm", "write to"],
        "message.read": ["get messages", "read", "show messages", "what did"],
        "channel.create": ["create channel", "new channel", "make channel"],
        "channel.archive": ["archive", "close channel", "shut down channel"],
        "channel.list": ["list channels", "show channels", "what channels"],
        "issue.create": ["create issue", "file issue", "open issue", "new issue"],
        "issue.close": ["close issue", "resolve issue"],
        "file.upload": ["upload", "attach", "send file"],
    }
    
    def classify(self, user_text: str) -> str:
        """Returns intent like 'message.send' or 'issue.create'."""
        text_lower = user_text.lower()
        
        for intent, patterns in self.INTENT_PATTERNS.items():
            if any(p in text_lower for p in patterns):
                return intent
        
        return "general"

Architecture Change 2: Use Composio's Semantic Selection
Replace token overlap with Composio's find_actions_by_use_case:

# In tool_router.py or a new composio_selector.py

from composio_openai import ComposioToolSet, App

class ComposioActionSelector:
    def __init__(self):
        self.toolset = ComposioToolSet()
    
    def select_actions_for_intent(
        self, 
        user_text: str, 
        apps: List[str],
        max_actions: int = 10
    ) -> List[Dict]:
        """
        Use Composio's semantic search instead of token overlap.
        """
        all_actions = []
        
        for app_name in apps:
            try:
                app = getattr(App, app_name.upper())
                
                # Use Composio's semantic matching
                action_enums = self.toolset.find_actions_by_use_case(
                    app,
                    use_case=user_text,
                    advanced=False  # Set True for complex workflows
                )
                
                # Limit per app
                all_actions.extend(action_enums[:5])
                
            except AttributeError:
                logger.warning(f"Unknown app: {app_name}")
        
        # Get tool definitions for selected actions only
        return self.toolset.get_tools(actions=all_actions[:max_actions])

Architecture Change 3: Destructive Action Guard (Layered Defense)
Your current guard is reactive. Make it proactive by excluding destructive actions from selection:

DESTRUCTIVE_ACTIONS = {
    "archive", "delete", "remove", "destroy", "close", "disable",
    "revoke", "terminate", "drop", "purge", "clear", "reset"
}

def filter_safe_actions(actions: List, user_intent: str) -> List:
    """Remove destructive actions unless explicitly requested."""
    
    intent_is_destructive = any(
        d in user_intent.lower() 
        for d in ["delete", "archive", "remove", "close"]
    )
    
    if intent_is_destructive:
        return actions  # User explicitly wants destruction
    
    return [
        a for a in actions
        if not any(d in a.name.lower() for d in DESTRUCTIVE_ACTIONS)
    ]

