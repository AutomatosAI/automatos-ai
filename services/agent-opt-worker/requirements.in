# agent-opt-worker's direct dependencies (PRD-262 US-006). The image installs
# requirements.lock, never this file: every pin there carries its hashes, and the
# Dockerfile installs it with --require-hashes --no-deps. Regenerate the lock from
# the repository root after changing this file:
#
#   uv pip compile services/agent-opt-worker/requirements.in \
#     --overrides services/agent-opt-worker/overrides.txt \
#     --python-version 3.11 --python-platform x86_64-unknown-linux-gnu \
#     --generate-hashes -o services/agent-opt-worker/requirements.lock
#
# overrides.txt keeps the PyPI package `fi` out: agent-opt 0.0.1 requires
# `fi>=0.0.2`, an unrelated 2019 sdist that runs setup.py at build. The `fi.*`
# modules the worker imports come from ai-evaluation (fi.evals) and agent-opt
# (fi.opt). CI fails on a `fi==` line in the lock.
#
# litellm is past 1.84.0, which fixes the KEV-listed GHSA-7488-6r32-c95q and
# GHSA-v4p8-mg3p-g94g. litellm 1.84 and later require openai>=2.20.0, and
# ai-evaluation 1.1.0 still caps openai<2, so overrides.txt lifts that cap.
fastapi==0.146.0
# GHSA-86qp-5c8j-p5mr (a forged Host header rewrites request.url.path) is fixed in 1.0.1.
starlette>=1.0.1
# Plain uvicorn: [standard]'s uvloop, httptools, watchfiles and websockets add
# 17.8 MB installed and this service needs none of them.
uvicorn==0.34.0
agent-opt==0.0.1
# 1.x provides fi.evals itself; 0.1.x still required the `fi` package.
ai-evaluation>=1.1.0
# 1.91.5 is the newest litellm that ships a pure-Python wheel (16.7 MB; 1.92 adds a
# Rust extension, and 1.95.1's manylinux wheel is 26.3 MB) and adds no package to
# the lock (1.96 adds pydantic-settings, 1.98 boto3). It is past every fixed
# litellm advisory, GHSA-3cv6-jpf6-8222 included (fixed in 1.91.5 on that line).
litellm==1.91.5
