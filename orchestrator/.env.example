# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orchestrator_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password_here

# Redis Configuration  
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
API_KEY=your_secure_api_key_here

# LLM Provider API Keys (REQUIRED - Get from providers)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/orchestrator.log

# Security
REQUIRE_AUTH=false  # Set to true (default) in production; false for local dev without Clerk
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Routing (Universal Orchestrator Router)
COMPOSIO_WEBHOOK_SECRET=your_composio_webhook_secret_here
ROUTING_CACHE_TTL_HOURS=24
ROUTING_LLM_CONFIDENCE_THRESHOLD=0.5

# GitHub repo for automated recipes (e.g., Jira Bug Triage → PR)
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=your-repo
GITHUB_DEFAULT_BRANCH=main

# Plugin Marketplace / S3
MARKETPLACE_S3_BUCKET=automatos-marketplace
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
PLUGIN_MAX_UPLOAD_SIZE_MB=10
PLUGIN_LLM_SCAN_MODEL=claude-haiku-4-20250414
PLUGIN_CACHE_TTL_SECONDS=3600

# Development
DEBUG=false
ENVIRONMENT=production

# AWS S3 Vectors (PRD-42: Cloud Document Sync)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
S3_VECTORS_ENABLED=true
