# Python. A pattern matches from the context root, so only `**/` reaches the
# __pycache__ and bytecode nested in every package (PRD-262 US-017).
**/__pycache__
**/*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
*.log.*

# Database
*.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.local
.env.*.local

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
*.md
docs/
README*

# Test files
tests/
test_*.py
*_test.py
.pytest_cache/
.coverage
htmlcov/

# Model cache (if large)
model_cache/
*.pth
*.pt
*.h5
*.ckpt

# Temporary files
tmp/
temp/
*.tmp

# OS
.DS_Store
Thumbs.db

# Credential key (should use env var)
.credential_key
core/.credential_key

# Python version managers (Nixpacks uses runtime.txt instead)
.python-version

# Development files
migrate_*.py
add-*.py

# Large data files
*.pdf
*.mp4
*.avi
*.mov
*.zip
*.tar.gz
# PRD-209: env files must never be baked into images — Next loads .env*/.env.local
# and config.py load_dotenv()s them, leaking dev/SaaS values into the local edition.
.env.*
**/.env
**/.env.*

# Runtime data and local caches (PRD-262 US-017): what the app and the dev tools
# write into a checkout, never code. /documents is DOCUMENT_STORAGE_DIR's default
# (relative to /app), where the compose bind mount used to put generated documents,
# thumbnails and brand files. Root-anchored on purpose: `**/documents` would drop
# modules/documents, and `**/*.md` the skill seeds the app loads (core/seeds).
/documents
scripts/eval/tool_routing/.embedding_cache.json
scripts/eval/**/results/
.import_linter_cache
