# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
*.log.*

# Database
*.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.local
.env.*.local

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
*.md
docs/
README*

# Test files
tests/
test_*.py
*_test.py
.pytest_cache/
.coverage
htmlcov/

# Model cache (if large)
model_cache/
*.pth
*.pt
*.h5
*.ckpt

# Temporary files
tmp/
temp/
*.tmp

# OS
.DS_Store
Thumbs.db

# Credential key (should use env var)
.credential_key
core/.credential_key

# Python version managers (Nixpacks uses runtime.txt instead)
.python-version

# Development files
migrate_*.py
add-*.py

# Large data files
*.pdf
*.mp4
*.avi
*.mov
*.zip
*.tar.gz
# PRD-209: env files must never be baked into images — Next loads .env*/.env.local
# and config.py load_dotenv()s them, leaking dev/SaaS values into the local edition.
.env.*
**/.env
**/.env.*
