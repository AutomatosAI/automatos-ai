# =============================================================================
# Automatos AI Platform — Environment Variables
# =============================================================================
# Copy to .env and fill in required values. DO NOT commit .env to git.
# Variables marked [REQUIRED] must be set. Others have sensible defaults.
# Generated from Railway production config (2026-04-09).
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Global
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (pgvector) — Main Database
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=orchestrator_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                          # [REQUIRED]
POSTGRES_PORT=5432
DATABASE_URL=                               # [REQUIRED] postgresql://user:pass@host:5432/db

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                             # [REQUIRED]
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=                                  # [REQUIRED] redis://:password@host:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# Qdrant — Vector Database
# ─────────────────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (Clerk)
# ─────────────────────────────────────────────────────────────────────────────
CLERK_JWKS_URL=                             # [REQUIRED]
CLERK_SECRET_KEY=                           # [REQUIRED]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=          # [REQUIRED]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
VITE_CLERK_PUBLISHABLE_KEY=                 # Landing page (same as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY)
VITE_AUTOMATOS_WORKSPACE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────────────
API_KEY=                                    # [REQUIRED]
CORS_ALLOW_ORIGINS=*
CREDENTIAL_ENCRYPTION_KEY=                  # [REQUIRED]
WIDGET_TOKEN_SECRET=
WORKER_INTERNAL_TOKEN=                      # [REQUIRED] Shared secret for worker auth

# ─────────────────────────────────────────────────────────────────────────────
# LLM Providers
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

OPENAI_API_KEY=                             # [REQUIRED] Used by mem0 + opt worker
ANTHROPIC_API_KEY=                          # [REQUIRED]
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings
# ─────────────────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─────────────────────────────────────────────────────────────────────────────
# Composio — Tool Integration
# ─────────────────────────────────────────────────────────────────────────────
COMPOSIO_KEY=
COMPOSIO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Mem0 — Long-term Memory
# ─────────────────────────────────────────────────────────────────────────────
MEM0_API_URL=http://mem0-server:8765
MEM0_PG_DB=mem0
MEM0_PG_USER=postgres
MEM0_PG_PASSWORD=                           # [REQUIRED]
MEM0_PG_PORT=5433

# ─────────────────────────────────────────────────────────────────────────────
# Voice Services
# ─────────────────────────────────────────────────────────────────────────────
VOICE_ENABLED=false
VOICE_SERVICE_URL=http://voice-service:8300
VOICE_SERVICE_PORT=8300
VOICE_PIPELINE_PORT=8301
NEXT_PUBLIC_VOICE_PIPELINE_URL=
TTS_ENGINE=chatterbox
TTS_DEFAULT_MODEL=chatterbox
TTS_DEFAULT_VOICE=default
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_MODEL=whisper-base
TTS_MODEL=chatterbox
TTS_VOICE=default
MAX_CONCURRENT_SESSIONS=10
ORCHESTRATOR_URL=http://automatos-ai-api:8000
METRICS_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Workers
# ─────────────────────────────────────────────────────────────────────────────
AGENT_OPT_WORKER_URL=http://agent-opt-worker:8080
WORKER_INTERNAL_URL=http://agent-workspace-worker:8081
WORKSPACE_DEFAULT_QUOTA_GB=5
WORKER_CONCURRENCY=3
MAX_OPTIMIZE_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────────────
# FutureAGI Observability
# ─────────────────────────────────────────────────────────────────────────────
FUTUREAGI_ENABLED=false
FUTUREAGI_API_KEY=
FUTUREAGI_SECRET_KEY=
FI_API_KEY=
FI_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AWS (S3 Vector Storage)
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_VECTORS_ENABLED=false
S3_VECTORS_BUCKET=
S3_VECTORS_DIMENSION=
S3_VECTORS_INDEX_NAME=
S3_VECTORS_METRIC=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Integration
# ─────────────────────────────────────────────────────────────────────────────
GITHUB=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DEFAULT_BRANCH=main
GITHUB_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Slack
# ─────────────────────────────────────────────────────────────────────────────
SLACK_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# URLs
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring — Grafana
# ─────────────────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=                 # [REQUIRED]
GF_SERVER_ROOT_URL=http://localhost:3030
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_LOKI_DATASOURCE_UID=
GRAFANA_PORT=3030

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring — Log Relay & Alerting
# ─────────────────────────────────────────────────────────────────────────────
LOG_RELAY_ENABLED=false
LOG_RELAY_URL=
LOG_RELAY_SECRET=
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
ALERT_INGEST_TOKEN=
PROMETHEUS_PORT=9090
LOKI_PORT=3100
LOG_RELAY_PORT=3200
ALERTMANAGER_PORT=9093

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring — Exporters
# ─────────────────────────────────────────────────────────────────────────────
DATA_SOURCE_NAME=                           # postgres-exporter connection string
REDIS_ADDR=                                 # redis-exporter connection string
PG_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121

# ─────────────────────────────────────────────────────────────────────────────
# Landing Page — Contact Form
# ─────────────────────────────────────────────────────────────────────────────
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
LANDING_PORT=8090

# ─────────────────────────────────────────────────────────────────────────────
# Adapter Admin (legacy)
# ─────────────────────────────────────────────────────────────────────────────
ADAPTER_ADMIN_BASE_URL=
ADAPTER_ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Railway-specific (auto-injected on Railway, not needed locally)
# ─────────────────────────────────────────────────────────────────────────────
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_PRIVATE_DOMAIN=
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_STATIC_URL=
# RAILWAY_VOLUME_MOUNT_PATH=
# RAILWAY_SERVICE_*_URL= (auto-generated service discovery)
# SHARED_CONTEXT_BACKEND=redis
# TASK_RUNNER_BACKEND=redis
