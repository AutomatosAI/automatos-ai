# PRD-262 US-047: one install config for the Dockerfile, frontend-ci and a contributor's
# machine, so every `npm ci` resolves the same tree from package-lock.json. The lock is
# written with this setting: it holds no peer-only packages (monaco-editor, which
# @monaco-editor/react loads from a CDN; prettier; @types/dom-mediacapture-record).
legacy-peer-deps=true
