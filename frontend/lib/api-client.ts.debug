  // ===== ANALYTICS - Using discovered endpoints =====
  getAnalyticsSuccessRate = () => this.request('/analytics/dashboard/success-rate')
  getTaskCompletionTime = () => this.request('/analytics/dashboard/task-completion-time')
  getSystemLoadTrend = () => this.request('/analytics/dashboard/system-load-trend')
