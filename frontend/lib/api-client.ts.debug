  getWorkflowExecution = (id: string) => this.request(`/workflows/executions/${id}`)
  getWorkflowExecutionResults = (id: string) => this.request(`/workflows/executions/${id}/results`)
  getRecommendedTemplates = () => this.request('/workflows/templates/recommended')

  // ===== SYSTEM - Using discovered endpoints =====
