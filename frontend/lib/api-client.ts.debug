/**
 * CORRECT API Client - Using REAL discovered endpoints
 * Based on comprehensive API testing results
 */

class ApiClient {
  private baseUrl: string
  private apiKey: string

  constructor() {
    // Use localhost for server-side rendering, external IP for client-side
    if (typeof window === 'undefined') {
      // Server-side: use localhost
      this.baseUrl = 'http://localhost:8000'
    } else {
      // Client-side: use external IP
      this.baseUrl = process.env.NEXT_PUBLIC_API_URL || 'http://206.81.0.227:8000'
    }
    this.apiKey = process.env.NEXT_PUBLIC_API_KEY || 'test_api_key_for_backend_validation_2025'
    console.log('🚀 API Client initialized:', this.baseUrl, typeof window === 'undefined' ? '(server)' : '(client)')
  }

  async request(endpoint: string, options: RequestInit = {}) {
    if (endpoint.match(/^\/(agents|documents|workflows)$/)) {
      endpoint = endpoint + '/'
    }
    
    const url = `${this.baseUrl}/api${endpoint}`
    console.log('📡 API Request:', url)
    console.log("DEBUG: About to fetch", url)
    
    try {
      console.log("DEBUG: Starting fetch..."); const response = await fetch(url, {
        ...options,
        headers: {
          'Content-Type': 'application/json',
          'X-API-Key': this.apiKey,
          ...options.headers,
        },
      })

      if (!response.ok) {
        console.error('❌ API Error:', response.status, response.statusText)
        throw new Error(`API Error: ${response.status}`)
      }

      const data = await response.json()
      console.log('✅ API Response:', endpoint, 'data:', data)
      return data
    } catch (error) {
      console.error('❌ Request failed:', error)
      throw error
    }
  }

  // ===== AGENTS - Using discovered endpoints =====
  getAgents = () => this.request('/agents/')
  getAgent = (id: string) => this.request(`/agents/${id}`)
  getAgentsAvailable = () => this.request('/agents/available')
  createAgent = (data: any) => this.request('/agents/', { method: 'POST', body: JSON.stringify(data) })
  updateAgent = (id: string, data: any) => this.request(`/agents/${id}`, { method: 'PUT', body: JSON.stringify(data) })
  deleteAgent = (id: string) => this.request(`/agents/${id}`, { method: 'DELETE' })
  getAgentSkills = (agentId: string) => this.request(`/agents/${agentId}/skills`)
  getAgentPatterns = (agentId: string) => this.request(`/agents/${agentId}/patterns`)
  getAgentPerformance = (agentId: string) => this.request(`/agents/${agentId}/performance`)
  
  // CORRECT URLs from discovery:
  getAgentStats = () => this.request('/system/agent-statistics')
  getAgentTypes = () => this.request('/system/agent-types')
  getAgentStatus = (agentId: string) => this.request(`/system/agent/${agentId}/status`)
  executeAgent = (agentId: string, data: any) => this.request(`/system/agent/${agentId}/execute`, { method: 'POST', body: JSON.stringify(data) })

  // ===== DOCUMENTS - Using discovered endpoints =====
  getDocuments = () => this.request('/documents/')
  getDocument = (id: string) => this.request(`/documents/${id}`)
  deleteDocument = (id: string) => this.request(`/documents/${id}`, { method: 'DELETE' })
  uploadDocument = async (formData: FormData) => {
    const url = `${this.baseUrl}/api/documents/upload`
    console.log("DEBUG: Starting fetch..."); const response = await fetch(url, {
      method: 'POST',
      headers: { 'X-API-Key': this.apiKey },
      body: formData
    })
    return response.json()
  }
  preprocessDocument = (data: any) => this.request('/documents/preprocess', { method: 'POST', body: JSON.stringify(data) })
  reprocessDocument = (id: string) => this.request(`/documents/${id}/reprocess`, { method: 'POST' })
  getDocumentContent = (id: string) => this.request(`/documents/${id}/content`)

  // Document stats - use context stats as discovered
  getDocumentStats = () => this.request('/context/stats')
  getDocumentCategories = () => this.request('/skills/categories') // Skills categories can work for documents

  // ===== WORKFLOWS - Using discovered endpoints =====
