node_modules
.next
.git
.gitignore
.env*
.vscode
.turbo
# PRD-262 US-048: tests, docs and TypeScript's incremental build cache never reach the image,
# and a change to one no longer reruns the source copy and the build. `**/*.md` replaces a
# `*.md` that matched only this directory; no code imports a .md file.
**/__tests__
**/*.test.*
**/*.md
tsconfig.tsbuildinfo
# PRD-209: env files must never be baked into images — Next loads .env*/.env.local
# and config.py load_dotenv()s them, leaking dev/SaaS values into the local edition.
.env
.env.*
.env.local
**/.env
**/.env.*
