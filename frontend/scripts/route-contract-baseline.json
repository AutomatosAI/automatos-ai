{
  "_comment": "PRD-182 S3 (F044) route-contract baseline. Pre-existing api-client calls to paths not in orchestrator/reports/route-manifest.json. The check fails only on a NEW violation not listed here. Shrink this list as calls are fixed or routers mounted; never grow it silently. Regenerate with: node scripts/check-route-contract.js --update-baseline",
  "normalised": [
    "/api/agents/*/patterns",
    "/api/agents/*/stats",
    "/api/agents/analytics",
    "/api/agents/available",
    "/api/analytics/metrics",
    "/api/documents/*/chunks",
    "/api/documents/*/preprocess",
    "/api/documents/*/search",
    "/api/documents/analytics/overview",
    "/api/documents/analytics/search-patterns",
    "/api/documents/processing/live",
    "/api/documents/processing/pipeline",
    "/api/documents/processing/reprocess-all",
    "/api/documents/team-counts",
    "/api/evaluation/performance-metrics",
    "/api/knowledge/graph/communities",
    "/api/knowledge/graph/community/*",
    "/api/knowledge/graph/community/*/label",
    "/api/knowledge/graph/node/*/neighbors",
    "/api/knowledge/graph/path",
    "/api/knowledge/graph/search",
    "/api/metrics/all",
    "/api/multi-agent/coordination/coordinate",
    "/api/multi-agent/health",
    "/api/multi-agent/optimization/statistics",
    "/api/multi-agent/reasoning/collaborative",
    "/api/orchestrator/execute-phase",
    "/api/orchestrator/task/submit",
    "/api/skills/*",
    "/api/skills/bulk",
    "/api/skills/categories",
    "/api/skills/single",
    "/api/system/activities",
    "/api/teams",
    "/api/usage/analytics"
  ],
  "examples": {
    "/api/agents/*/patterns": "/api/agents/${agentId}/patterns",
    "/api/agents/*/stats": "/api/agents/${id}/stats",
    "/api/agents/analytics": "/api/agents/analytics?timeRange=${timeRange}",
    "/api/agents/available": "/api/agents/available",
    "/api/analytics/metrics": "/api/analytics/metrics",
    "/api/documents/*/chunks": "/api/documents/${documentId}/chunks",
    "/api/documents/*/preprocess": "/api/documents/${documentId}/preprocess",
    "/api/documents/*/search": "/api/documents/${documentId}/search",
    "/api/documents/analytics/overview": "/api/documents/analytics/overview",
    "/api/documents/analytics/search-patterns": "/api/documents/analytics/search-patterns",
    "/api/documents/processing/live": "/api/documents/processing/live",
    "/api/documents/processing/pipeline": "/api/documents/processing/pipeline",
    "/api/documents/processing/reprocess-all": "/api/documents/processing/reprocess-all",
    "/api/documents/team-counts": "/api/documents/team-counts",
    "/api/evaluation/performance-metrics": "/api/evaluation/performance-metrics",
    "/api/knowledge/graph/communities": "/api/knowledge/graph/communities",
    "/api/knowledge/graph/community/*": "/api/knowledge/graph/community/${communityId}?max_nodes=${maxNodes}",
    "/api/knowledge/graph/community/*/label": "/api/knowledge/graph/community/${communityId}/label",
    "/api/knowledge/graph/node/*/neighbors": "/api/knowledge/graph/node/${encodeURIComponent(nodeId)}/neighbors?max_nodes=${maxNodes}",
    "/api/knowledge/graph/path": "/api/knowledge/graph/path?source=${encodeURIComponent(source)}&target=${encodeURIComponent(target)}",
    "/api/knowledge/graph/search": "/api/knowledge/graph/search?q=${encodeURIComponent(query)}&limit=${limit}",
    "/api/metrics/all": "/api/metrics/all",
    "/api/multi-agent/coordination/coordinate": "/api/multi-agent/coordination/coordinate",
    "/api/multi-agent/health": "/api/multi-agent/health",
    "/api/multi-agent/optimization/statistics": "/api/multi-agent/optimization/statistics",
    "/api/multi-agent/reasoning/collaborative": "/api/multi-agent/reasoning/collaborative",
    "/api/orchestrator/execute-phase": "/api/orchestrator/execute-phase",
    "/api/orchestrator/task/submit": "/api/orchestrator/task/submit",
    "/api/skills/*": "/api/skills/${id}",
    "/api/skills/bulk": "/api/skills/bulk",
    "/api/skills/categories": "/api/skills/categories",
    "/api/skills/single": "/api/skills/single",
    "/api/system/activities": "/api/system/activities?limit=${limit}",
    "/api/teams": "/api/teams",
    "/api/usage/analytics": "/api/usage/analytics?timeRange=${timeRange}"
  }
}
