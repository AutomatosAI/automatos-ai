# =============================================================================
# Automatos AI - Environment Configuration
# =============================================================================
# QUICK START:
#   1. Copy this file: cp .env.example .env
#   2. Update the values below (API keys optional for testing)
#   3. Run: docker-compose up
# =============================================================================

# =============================================================================
# Database Configuration (PostgreSQL + pgvector)
# =============================================================================
POSTGRES_DB=orchestrator_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_secure_password_here
POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration (Cache & Sessions)
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_secure_redis_password
REDIS_PORT=6379

# =============================================================================
# API Configuration
# =============================================================================
API_PORT=8000
API_KEY=CHANGE_ME_secure_api_key

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# =============================================================================
# LLM API Keys (Optional - Platform works without these for testing)
# =============================================================================
# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# Required for: AI agents, embeddings, chat completions
OPENAI_API_KEY=

# Anthropic API Key  
# Get yours at: https://console.anthropic.com/settings/keys
# Required for: Claude models
ANTHROPIC_API_KEY=

# =============================================================================
# Authentication (PRD-37: SaaS Foundation)
# =============================================================================
# Clerk (frontend auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Workspace
DEFAULT_WORKSPACE_ID=

# Set to "false" to disable auth (dev-only; defaults to "true")
REQUIRE_AUTH=true

# =============================================================================
# Environment Settings
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO


# =============================================================================
# Object Storage — local MinIO (PRD-176 F089)
# =============================================================================
# Local compose runs a MinIO S3-compatible object store so the knowledge
# flywheel persists generated outputs instead of losing them. Defaults below
# work out of the box; override only if you change the MinIO service.
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# S3_ENDPOINT_URL=http://minio:9000        # unset in prod → real AWS S3
# S3_DOCUMENTS_BUCKET=automatos-ai

# =============================================================================
# AWS S3 Vectors (PRD-42: Cloud Document Sync) — real S3 (prod)
# =============================================================================
# Leave S3_ENDPOINT_URL unset (above) to target real AWS S3 with these creds.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_VECTORS_ENABLED=true

# =============================================================================
# Admin Tools (Optional - Only used with --profile all)
# =============================================================================
ADMINER_PORT=8080

# =============================================================================
# NOTES:
# =============================================================================
# - REQUIRED: Set POSTGRES_PASSWORD, REDIS_PASSWORD, and API_KEY before running
# - Change ALL passwords for production deployments
# - API keys are optional - platform boots without them
# - Add your OpenAI key when ready to use AI features
# - See docs/QUICKSTART.md for detailed setup guide
# =============================================================================

# PRD-234 S2 (local edition, session mode): your own projects folder. Shown
# read-only in Deliverables → Explorer under projects/ and registered by the
# CLI host, so a Claude Code session can work in a real repository inside it.
# Unset = ./workspaces/projects (empty). Restart with `make up` after changing.
# LOCAL_PROJECTS_DIR=/Users/you/Development
