# =============================================================================
# Automatos AI — Backend (API) local defaults · env-file syntax · NO SECRETS
# =============================================================================
# Prefilled local-topology settings for a clone-and-run docker compose stack.
# Secrets (passwords, API keys) live ONLY in the root .env (see .env.example).
#
# - Committed to git on purpose: every value here is non-secret local wiring.
# - Named *.defaults (not *.env) so the repo's block-secrets guard
#   (.claude/hooks/block-secrets.sh) never matches it; docker compose accepts
#   any filename via `env_file:` (wired by PRD-153 US-002).
# - Personal overrides: create envs/api.local (gitignored), listed after this
#   file in compose `env_file:` so it wins.
# - SaaS/Railway is NOT affected: Railway sets its own env per service; this
#   file describes the LOCAL topology only.
#
# Tags: [ACTIVE]   read by the code today
#       [PRD-15x]  takes effect when that PRD lands; harmless until then
# =============================================================================

# -----------------------------------------------------------------------------
# Core topology [ACTIVE]
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=orchestrator_db
POSTGRES_USER=postgres
# POSTGRES_PASSWORD -> root .env

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD -> root .env

ENVIRONMENT=development
LOG_LEVEL=INFO

# Document conversion sidecar (compose profile: all) [ACTIVE]
GOTENBERG_URL=http://gotenberg:3000

# -----------------------------------------------------------------------------
# Edition & auth [ACTIVE] — the ONE shipped flag (PRD-175)
# -----------------------------------------------------------------------------
# local -> no Clerk, no login, single shared workspace. config.py forces
# REQUIRE_AUTH=false when AUTH_EDITION=local, so operators set ONE flag, not
# three that can silently contradict. Flip to saas (+ Clerk keys in the root
# .env) for a Clerk-mode local stack; Railway/SaaS is unaffected (it sets its
# own env per service and never reads this file).
AUTH_EDITION=local

# [ACTIVE] Persist the auto-generated credential-encryption key on the backend_data
# volume (compose) — inside the image it would vanish on the next recreate and every
# stored API key would become undecryptable. Set CREDENTIAL_ENCRYPTION_KEY in .env
# to pin your own key instead.
CREDENTIAL_KEY_FILE=/app/data/.credential_key

# [ACTIVE] The single local workspace every anonymous request resolves to.
# This exact id is what the CI seed (orchestrator/scripts/init_test_db.py) and
# the entrypoint seed create; validate_auth_edition() (config.py) hard-requires
# it non-empty in local mode. Fixed well-known UUID (workspaces.id is UUID).
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-0000000000c1

# [ACTIVE] The local operator's identity (users id 1, seeded by the entrypoint);
# the anonymous local session carries this email so chat and attribution resolve
# a real user. Editable profile = PRD-233 S6.
LOCAL_OPERATOR_EMAIL=local@automatos.local

# [ACTIVE] Embeddings (RAG, memory, semantic routing) resolve their provider key
# from the PLATFORM key slot — core/llm/workspace_keys.py reads the key row of
# THIS workspace (the PR #610 'read the key where it lives' seam). Locally that
# is the single default workspace, so the OpenRouter/OpenAI key you add in
# Settings → API Keys powers embeddings too. Unset, every document upload ends
# 'failed' (no embedding provider) while the API still says 'uploaded'.
PLATFORM_KEY_WORKSPACE_ID=00000000-0000-0000-0000-0000000000c1

# -----------------------------------------------------------------------------
# Workspace worker — the Code Canvas runtime, in the default compose profile
# -----------------------------------------------------------------------------
# [ACTIVE] Where the backend reaches the worker's internal HTTP API (file
# browser, Code Canvas sessions, sandboxed exec — core/workspace_client.py).
# config.py's code default is http://localhost:8081, which inside the backend
# container reaches nothing; the compose service name is the answer (PRD-233 S1).
WORKER_INTERNAL_URL=http://workspace-worker:8081
# WORKER_INTERNAL_TOKEN -> root .env (optional; compose passes it to both services)

# [ACTIVE] The worker's files live on YOUR machine: compose bind-mounts the host
# directory ${AUTOMATOS_WORKSPACE_DIR:-./workspaces} (root .env dial) at
# /workspaces in both containers — read-write for the worker, read-only here.
# This is the in-container path; it stays fixed when you move the host directory.
# The worker reads the same variable through worker_config.workspace_root().
WORKSPACE_VOLUME_PATH=/workspaces

# -----------------------------------------------------------------------------
# Object storage — MinIO (S3-compatible, ships in the compose stack)
# -----------------------------------------------------------------------------
# [PRD-151] One S3 code path; these point it at the local MinIO container.
S3_ENDPOINT_URL=http://minio:9000
# Browser-facing presigned URLs must use the host-reachable endpoint:
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_USE_PATH_STYLE=true
# MinIO ignores region; kept for AWS-API compatibility. [ACTIVE]
AWS_REGION=us-east-1
# The store's credentials arrive as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, which
# compose maps FROM S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_REGION in .env
# (MinIO root creds by default) — a developer's own AWS_* never reaches the store.

# [ACTIVE] Vector store: pgvector in the main Postgres is the default.
# AWS S3 Vectors is a SaaS-only opt-in; never enable it against MinIO.
S3_VECTORS_ENABLED=false

# Bucket names: code defaults from config.py apply; override here if needed.
# Buckets are auto-created on first use against MinIO (PRD-151 US-007).
# S3_DOCUMENTS_BUCKET=
# MARKETPLACE_S3_BUCKET=automatos-marketplace
# RECIPE_LOG_S3_BUCKET=automatos-ai

# -----------------------------------------------------------------------------
# Memory & vectors
# -----------------------------------------------------------------------------
# HONEST NOTE: neither mem0 nor Qdrant ships in the default compose stack today,
# so durable (L3) memory and field memory are OFF in the local edition — the
# backend degrades gracefully (these DNS names simply never resolve). Adding
# both as optional compose profiles is PRD-233 territory. If you run your own
# instances, point these at them and the features light up.
MEM0_API_URL=http://mem0-server:8765
# MEM0_API_KEY: set it in envs/api.local if you run your own mem0 (.env values are
# substitution-only; compose does not pass MEM0_API_KEY through)
QDRANT_URL=http://qdrant:6333

# -----------------------------------------------------------------------------
# Internal/optional services — OFF locally [ACTIVE as overrides]
# -----------------------------------------------------------------------------
# Empty URL = feature disabled with a clean log line (PRD-152 makes these the
# code defaults; until then these overrides silence Railway-internal retries).
LOG_RELAY_ENABLED=false
LOG_RELAY_URL=
LOKI_URL=
PROMETHEUS_URL=
AGENT_OPT_WORKER_URL=
# Observability (Loki/Prometheus/Grafana) is not part of this compose file — see the
# automatos-monitoring repo; envs/observability.defaults documents the variables.
