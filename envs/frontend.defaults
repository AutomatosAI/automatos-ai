# =============================================================================
# Automatos AI — Frontend local defaults · env-file syntax · NO SECRETS
# =============================================================================
# Prefilled local settings for the Next.js frontend under docker compose.
# Secrets live ONLY in the root .env. Named *.defaults (not *.env) so the
# repo's block-secrets guard never matches it; wired via compose `env_file:`
# (PRD-153 US-002). Personal overrides: envs/frontend.local (gitignored).
#
# SaaS/Railway is NOT affected — Railway sets its own env per service.
#
# NOTE: the browser's NEXT_PUBLIC_* values are inlined at BUILD time in the
# production target, which the default stack runs (PRD-262 US-035/US-036). The
# published image has the local edition, http://localhost:8000 and
# http://localhost:9000 baked in; `make up` builds the frontend here instead,
# passing the values in .env as build args, when .env sets others (self-hosting.md
# §1b). So a NEXT_PUBLIC_* value changed here does not change what the browser
# gets from that image: set it in .env. `make dev`'s development target
# (docker-compose.dev.yml) reads them at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# Core wiring [ACTIVE]
# -----------------------------------------------------------------------------
# Browser-reachable backend endpoints (host ports, not service DNS):
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# NODE_ENV is set by compose: production in docker-compose.yml, development in
# docker-compose.dev.yml (environment: wins over this file).
# Server-side (Next API routes run INSIDE the frontend container): reach the
# backend by compose DNS. The browser keeps using NEXT_PUBLIC_API_URL above.
BACKEND_INTERNAL_URL=http://backend:8000

# -----------------------------------------------------------------------------
# Edition [ACTIVE] — the ONE shipped flag (PRD-175), mirror of backend AUTH_EDITION
# -----------------------------------------------------------------------------
# local -> no ClerkProvider mounted, no sign-in, no team/billing UI
# saas  -> current Clerk behaviour (requires NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY)
# Read by frontend/lib/auth-edition.ts (process.env.NEXT_PUBLIC_AUTH_EDITION).
NEXT_PUBLIC_AUTH_EDITION=local

# Clerk keys are SaaS-only and intentionally absent here.
# OSS local runs never set them; SaaS gets them from Railway env.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY -> (SaaS only, root .env / Railway)
